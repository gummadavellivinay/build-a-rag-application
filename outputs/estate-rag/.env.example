# Copy to .env. Never commit secrets.
OPENAI_API_KEY=
PINECONE_API_KEY=
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
PINECONE_INDEX=estate-dense-v1
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
RERANK_MODEL=bge-reranker-v2-m3
# Each ingest creates an immutable revision. Use exactly the same revision for serving.
CORPUS_REVISION=v1
DATA_DIR=./data
OCR_LANGUAGES=eng+spa+fra
# JSON token -> tenant mapping. Generate long random values; no default API credentials.
API_TOKENS={"replace-with-long-random-token":"demo"}
# Optional approved HTTPS inventory service; otherwise explicitly labelled fixture inventory is used.
INVENTORY_BASE_URL=
INVENTORY_API_TOKEN=
